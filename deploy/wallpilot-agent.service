[Unit]
Description=WallPilot privileged firewall agent
Documentation=https://github.com/Zzsv/wallpilot
After=dbus.service polkit.service
Before=wallpilot-web.service

[Service]
Type=simple
User=root
Group=root
Environment=WALLPILOT_STATE_DIR=/var/lib/wallpilot
Environment=WALLPILOT_AGENT_SOCKET=/run/wallpilot/agent.sock
RuntimeDirectory=wallpilot
RuntimeDirectoryMode=0755
ExecStart=/opt/wallpilot/venv/bin/wallpilot-agent
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/wallpilot /run/wallpilot
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
